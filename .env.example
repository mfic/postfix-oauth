# --- Entra ID app registration (client credentials flow) ---
# Needs Graph Mail.Send (graph mode) or SMTP.SendAsApp (smtp mode) - see README.
# The outbound mode itself is chosen by the compose file you start:
# docker-compose.graph.yml or docker-compose.smtp.yml.
# COMPOSE_FILE makes that choice permanent: plain `docker compose` and update.sh
# then use this file.
COMPOSE_FILE=docker-compose.graph.yml

TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
# As Entra shows it, without URL-encoding it
CLIENT_SECRET=your-client-secret

# smtp mode only: the M365 mailbox Postfix authenticates as (needs SMTP AUTH
# enabled and the service principal registered on it - see README)
#RELAY_MAILBOX=printers@example.com

# graph mode, optional: where failure notices go, and the mailbox they are sent
# as. Set both or neither. The sender must be in the app's scope (README step 2a);
# the recipient need not be. Without them, failures only reach the log.
#FAILURE_NOTICE_MAILBOX=it@example.com
#FAILURE_NOTICE_SENDER=no-reply@example.com
# Attach the failed message to the notice (yes or no, default no). Its recipient
# then receives whatever the printer sent, including scans.
#FAILURE_NOTICE_ATTACH_MESSAGE=no

# Hostname the relay announces (HELO / TLS cert CN)
POSTFIX_HOSTNAME=mailrelay.example.com

# Oldest TLS version the relay accepts (default TLSv1.2). Set TLSv1 only for a printer
# that can't do better: README step 4.
#TLS_MIN_VERSION=TLSv1.2

# Optional: a Let's Encrypt certificate through Cloudflare DNS (README step 4). Also
# needs cloudflare.ini. POSTFIX_HOSTNAME must be in a public domain on Cloudflare.
#COMPOSE_PROFILES=letsencrypt
# Let's Encrypt's staging server, for a first test:
#LETSENCRYPT_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
