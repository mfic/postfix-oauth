# --- Entra ID app registration (client credentials flow, Graph Mail.Send) ---
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret

# Hostname the relay announces (HELO / TLS cert CN)
POSTFIX_HOSTNAME=mailrelay.example.com

# Printers allowed to relay WITHOUT authentication, by fixed IP.
# Space-separated list of IPs/CIDRs. Leave empty to require auth for everyone.
PRINTER_NETWORKS=192.168.10.21/32 192.168.10.22/32
