{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "**/vendor/**"],
  "packageRules": [
    {
      "description": "debian:trixie-slim is pinned to a release codename on purpose - a jump to the next Debian release is a deliberate decision, not a routine update.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian"],
      "enabled": false
    },
    {
      "description": "GitHub Actions bumps are safe to batch.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "sasl-xoauth2 version pinned as a Dockerfile build arg",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG SASL_XOAUTH2_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "tarickb/sasl-xoauth2",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
    }
  ]
}
